{
  "name": "escpos-direct",
  "version": "0.1.1",
  "description": "ESC/POS thermal printing for Node and the browser, writing straight to the USB endpoint. Correct code pages, real printer status, no CUPS in the way.",
  "type": "module",
  "license": "MIT",
  "author": "Fransuelton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fransuelton/escpos-direct.git"
  },
  "bugs": "https://github.com/Fransuelton/escpos-direct/issues",
  "homepage": "https://github.com/Fransuelton/escpos-direct#readme",
  "keywords": [
    "escpos",
    "esc-pos",
    "thermal-printer",
    "receipt-printer",
    "pos",
    "usb",
    "webusb",
    "cp850",
    "58mm",
    "macos",
    "cups"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "README.pt-BR.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./usb": {
      "import": { "types": "./dist/usb.d.mts", "default": "./dist/usb.mjs" },
      "require": { "types": "./dist/usb.d.cts", "default": "./dist/usb.cjs" }
    },
    "./cups": {
      "import": { "types": "./dist/cups.d.mts", "default": "./dist/cups.mjs" },
      "require": { "types": "./dist/cups.d.cts", "default": "./dist/cups.cjs" }
    },
    "./file": {
      "import": { "types": "./dist/file.d.mts", "default": "./dist/file.mjs" },
      "require": { "types": "./dist/file.d.cts", "default": "./dist/file.cjs" }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:codepages": "node scripts/gen-codepages.mjs > src/codepage/tables.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "usb": "^3.0.1"
  },
  "peerDependenciesMeta": {
    "usb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "usb": "3.0.1",
    "vitest": "4.1.10"
  }
}
